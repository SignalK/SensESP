{
  "name": "picotts",
  "version": "1.1.3",
  "description": "PlatformIO wrapper for the DiUS esp-picotts text-to-speech engine",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiUS/esp-picotts.git"
  },
  "frameworks": "arduino",
  "platforms": ["espressif32"],
  "build": {
    "srcDir": ".",
    "includeDir": "esp-picotts/include",
    "srcFilter": [
      "+<picotts_resources.S>",
      "+<picotts_multilang.c>",
      "+<esp-picotts/esp_picorsrc.c>",
      "+<esp-picotts/pico/lib/*.c>",
      "-<esp-picotts/pico/lib/picorsrc.c>"
    ],
    "extraScript": "build.py"
  }
}
